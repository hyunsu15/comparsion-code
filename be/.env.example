# 서버 포트
PORT=50004

# 실행 프로파일
#   MOCK    → 인메모리 목 데이터 (DB 불필요, 로컬 개발용)
#   DEFAULT → 실제 Oracle 사용 (아래 DB 접속정보 필요)
PROFILE=MOCK

# ── 아래는 PROFILE=DEFAULT 일 때만 사용됩니다 (MOCK이면 무시) ──────────────
# 운영 데이터용 기본 풀 (poolAlias=default)
DB_USER=scott
DB_PASSWORD=tiger
DB_CONNECTION_STRING=localhost:1521/xe

# 메타데이터용 풀 (poolAlias=metadata)
#   DEFAULT 프로파일에서는 default/metadata 두 풀이 모두 초기화되므로 6개 값 모두 필수.
#   별도 메타 스키마가 없다면 위 default 값과 동일하게 채우면 됩니다.
META_DB_USER=scott
META_DB_PASSWORD=tiger
META_DB_CONNECTION_STRING=localhost:1521/xe
