#include <stdio.h>
#include <string.h>
#include <stdlib.h>

// ========================================================
// 1. 내부 함수 선언부 (Prototype - #include 아래 배치)
// ========================================================
static double calculate_tax(double sal);
double calculate_bonus(double sal);
void print_row(char* name, double base, double tax, double bonus);
void check_error(const char* msg);
void process_employee(char* name, double sal);

/* SQL 통신 영역 선언 */
EXEC SQL INCLUDE sqlca;

int main() {
    // ========================================================
    // 2. 호스트 변수 선언 영역
    // ========================================================
    EXEC SQL BEGIN DECLARE SECTION;
        char userid[40] = "scott/tiger@xe";
        char emp_name[20];
        double salary;
    EXEC SQL END DECLARE SECTION;

    // DB 연결
    EXEC SQL CONNECT :userid;
    if (sqlca.sqlcode != 0) {
        printf("DB 연결 실패!\n");
        return 1;
    }

    // 커서 선언 및 오픈
    EXEC SQL DECLARE c1 CURSOR FOR 
        SELECT ename, sal FROM emp WHERE deptno = 20;

    EXEC SQL OPEN c1;
    check_error("커서 오픈 실패"); // 내부 함수 4 사용

    printf("%-10s | %10s | %10s | %10s | %10s\n", "이름", "기본급", "세금(-)", "보너스(+)", "실수령액");
    printf("-------------------------------------------------------------------------\n");

    // 데이터 패치 루프
    while(1) {
        EXEC SQL FETCH c1 INTO :emp_name, :salary;
        
        if (sqlca.sqlcode == 1403) break; // 데이터 끝
        check_error("데이터 패치 실패");   // 내부 함수 4 사용

        // 내부 함수 5 호출
        process_employee(emp_name, salary);
    }

    // 커서 닫기 및 연결 종료
    EXEC SQL CLOSE c1;
    EXEC SQL COMMIT WORK RELEASE;
    return 0;
}

// ========================================================
// 3. 함수 구현부 (main 함수 바깥 하단)
// ========================================================

// [내부 함수 1] 세금 계산
static double calculate_tax(double sal) {
    return sal * 0.1;
}

// [내부 함수 2] 보너스 계산
double calculate_bonus(double sal) {
    return sal * 0.15;
}

// [내부 함수 3] 라인 출력
void print_row(char* name, double base, double tax, double bonus) {
    double net_pay = base - tax + bonus;
    printf("%-10s | %10.2f | %10.2f | %10.2f | %10.2f\n", 
           name, base, tax, bonus, net_pay);
}

// [내부 함수 4] 에러 체크 및 롤백
void check_error(const char* msg) {
    if (sqlca.sqlcode < 0) {
        printf("\n[에러] %s (Code: %d)\n", msg, sqlca.sqlcode);
        EXEC SQL ROLLBACK WORK RELEASE;
        exit(1);
    }
}

// [내부 함수 5] 종합 처리 함수 (내부에서 다른 내부 함수들을 호출)
void process_employee(char* name, double sal) {
    double t = calculate_tax(sal);    // 내부 함수 1 호출
    double b = calculate_bonus(sal);  // 내부 함수 2 호출
    print_row(name, sal, t, b);       // 내부 함수 3 호출
}