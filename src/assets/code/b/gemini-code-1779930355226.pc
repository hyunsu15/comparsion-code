#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <time.h>

// ========================================================
// 1. 내부 함수 선언부 (Prototype - 최상단 배치)
// ========================================================
int is_valid_email(const char* email);
int is_valid_password(const char* password);
void get_current_time(char* time_buf);
void handle_registration_error(const char* reason);
void process_registration(const char* email, const char* password, const char* name);

/* SQL 통신 영역 선언 */
EXEC SQL INCLUDE sqlca;

int main() {
    // 테스트용 가입 입력 데이터 (외부 입력값 가정)
    const char* input_email = "user@example.com";
    const char* input_password = "securePassword123";
    const char* input_name = "홍길동";

    printf("회원가입 요청을 처리하는 중...\n");

    // 내부 함수 5 호출을 통해 전체 검증 및 DB 입력 프로세스 구동
    process_registration(input_email, input_password, input_name);

    return 0;
}

// ========================================================
// 2. 내부 함수 구현부 (main 함수 바깥 하단)
// ========================================================

// [내부 함수 1] 이메일 형식 간단 검증 (골뱅이 '@' 포함 여부 확인)
int is_valid_email(const char* email) {
    if (strchr(email, '@') != NULL) {
        return 1; // 유효함
    }
    return 0; // 유효하지 않음
}

// [내부 함수 2] 비밀번호 복잡성 검증 (8자 이상 글자수 확인)
int is_valid_password(const char* password) {
    if (password != NULL && strlen(password) >= 8) {
        return 1; // 유효함
    }
    return 0; // 유효하지 않음
}

// [내부 함수 3] 현재 시스템 날짜/시간 포맷팅 문자열 생성
void get_current_time(char* time_buf) {
    time_t timer = time(NULL);
    struct tm* t = localtime(&timer);
    // YYYY-MM-DD HH:MM:SS 형태로 포맷팅
    sprintf(time_buf, "%04d-%02d-%02d %02d:%02d:%02d", 
            t->tm_year + 1900, t->tm_mon + 1, t->tm_mday, 
            t->tm_hour, t->tm_min, t->tm_sec);
}

// [내부 함수 4] 가입 실패 에러 처리 및 프로그램 종료
void handle_registration_error(const char* reason) {
    printf("\n[가입 실패] %s\n", reason);
    
    // Oracle 에러 코드가 존재한다면 출력 후 롤백
    if (sqlca.sqlcode < 0) {
        printf("Oracle 에러 코드: %d\n", sqlca.sqlcode);
        EXEC SQL ROLLBACK WORK RELEASE;
    }
    
    printf("프로그램을 안전하게 종료합니다.\n");
    exit(1);
}

// [내부 함수 5] 종합 회원 가입 처리 프로세스 (DB INSERT 포함)
void process_registration(const char* email, const char* password, const char* name) {
    // Pro*C 내부 호스트 변수 선언 영역
    EXEC SQL BEGIN DECLARE SECTION;
        char h_userid[40] = "scott/tiger@xe";
        char h_email[50];
        char h_password[50];
        char h_name[30];
        char h_join_date[20];
    EXEC SQL END DECLARE SECTION;

    // 1) 이메일 검증 (내부 함수 1 사용)
    if (!is_valid_email(email)) {
        handle_registration_error("유효하지 않은 이메일 형식입니다."); // 내부 함수 4 사용
    }

    // 2) 비밀번호 검증 (내부 함수 2 사용)
    if (!is_valid_password(password)) {
        handle_registration_error("비밀번호는 8자 이상이어야 합니다."); // 내부 함수 4 사용
    }

    // 3) 시간 포맷팅 (내부 함수 3 사용)
    get_current_time(h_join_date);

    // 호스트 변수에 값 복사
    strcpy(h_email, email);
    strcpy(h_password, password);
    strcpy(h_name, name);

    // 4) DB 접속
    EXEC SQL CONNECT :h_userid;
    if (sqlca.sqlcode != 0) {
        handle_registration_error("데이터베이스 연결에 실패했습니다.");
    }

    // 5) 데이터 원격 삽입 (SQL 실행)
    EXEC SQL INSERT INTO users (email, password, name, join_date)
             VALUES (:h_email, :h_password, :h_name, :h_join_date);

    // SQL 수행 에러 체크
    if (sqlca.sqlcode < 0) {
        handle_registration_error("DB 가입 데이터 저장 중 오류 발생.");
    }

    // 커밋 및 연결 해제
    EXEC SQL COMMIT WORK RELEASE;

    // 최종 가입 성공 출력
    printf("\n--- 회원가입이 완료되었습니다 (Pro*C) ---\n");
    printf("이  름 : %s\n", h_name);
    printf("이메일 : %s\n", h_email);
    printf("가입일 : %s\n", h_join_date);
    printf("-----------------------------------------\n");
}