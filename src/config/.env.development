# 로컬 개발용 환경변수 (npm run dev = development 모드에서 로드)
# Vite 는 VITE_ 접두사 변수만 클라이언트 코드에 노출한다.

# 프론트가 호출할 백엔드 API base URL
VITE_API_BASE_URL=http://localhost:50004

# 대분류 매핑(개발) — parser 클래스이름별 env.
#   한 parser가 여러 대분류를 담당하면 콤마(,)로 나열한다 → 내부에서 Set 으로 매칭.
#   예) VITE_Pb5XmlParser=zzz,국제표준,공통
VITE_Pb5ClassImplMethodParser=aaa
VITE_Pb5ClassImplParser=yyy
VITE_Pb5XmlParser=zzz
VITE_Pb5ServiceParser=서비스

VITE_PbServiceParser=서비스
VITE_PbSqlParser=SP
VITE_PB_SQL_PREFIX= 'sqlw_'